<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filter_screen_constraints"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/med_phone_side_margin"
    android:layout_marginTop="@dimen/med_phone_top_margin"
    android:layout_marginRight="@dimen/med_phone_side_margin"
    android:layout_marginBottom="@dimen/med_phone_bot_margin"
    app:layout_constraintTop_toTopOf="parent">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="212dp"
        android:layout_height="49dp"
        android:layout_marginStart="20dp"
        android:text="@string/fs_title_text"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/save_filters"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/small_button_height"
        android:layout_marginStart="@dimen/small_button_padding"
        android:layout_marginEnd="@dimen/small_button_padding"
        android:text="@string/save_filters"
        app:layout_constraintBaseline_toBaselineOf="@+id/clear_filters"
        app:layout_constraintEnd_toStartOf="@+id/selectButton"
        app:layout_constraintStart_toEndOf="@+id/clear_filters" />

    <Button
        android:id="@+id/clear_filters"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/small_button_height"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="12dp"
        android:text="@string/clear_filters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/selectButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/small_button_height"
        android:layout_marginEnd="12dp"
        android:text="@string/exit_button"
        app:layout_constraintBaseline_toBaselineOf="@+id/save_filters"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/filter_table"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="32dp"
        android:dividerPadding="10dp"
        android:orientation="vertical"
        android:paddingStart="5dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/clear_filters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text">

        <LinearLayout
            android:id="@+id/type_filter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/type_f_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/category_filter"
                android:textAlignment="center" />

            <Spinner
                android:id="@+id/type_spinner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/material_filter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/material_f_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/material_filter"
                android:textAlignment="center" />

            <Spinner
                android:id="@+id/material_spinner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/period_filter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/period_f_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/period_filter"
                android:textAlignment="center" />

            <Spinner
                android:id="@+id/period_spinner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

