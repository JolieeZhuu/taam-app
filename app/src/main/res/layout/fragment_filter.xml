<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filter_screen_constraints"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:layout_marginStart="@dimen/med_phone_side_margin"
    android:layout_marginTop="@dimen/med_phone_top_margin"
    android:layout_marginEnd="@dimen/med_phone_side_margin"
    android:layout_marginBottom="@dimen/med_phone_bot_margin">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="49dp"
        android:fontFamily="@font/noto_serif_sc_semi_bold"
        android:gravity="center"
        android:text="@string/fs_title_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_filters"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/small_button_height"
        android:layout_marginStart="@dimen/small_button_padding"
        android:layout_marginEnd="@dimen/small_button_padding"
        android:includeFontPadding="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/save_button"
        android:textAllCaps="false"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="8dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="@+id/clear_filters"
        app:layout_constraintBottom_toBottomOf="@+id/clear_filters"
        app:layout_constraintEnd_toStartOf="@+id/exit_screen"
        app:layout_constraintStart_toEndOf="@+id/clear_filters" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clear_filters"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/small_button_height"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/clear_button"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="8dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_screen"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/small_button_height"
        android:layout_marginEnd="12dp"
        android:includeFontPadding="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/exit_button"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="8dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="@+id/clear_filters"
        app:layout_constraintBottom_toBottomOf="@+id/clear_filters"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:background="@drawable/filter_table_outline"
        android:id="@+id/filter_table"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:paddingStart="5dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/clear_filters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"
        app:layout_constraintVertical_bias="0.0">


        <LinearLayout
            android:id="@+id/type_filter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/type_f_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/category_filter"
                android:textColor="?attr/colorOnSurface" />

            <Spinner
                android:id="@+id/type_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/material_filter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/material_f_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/material_filter"
                android:textColor="?attr/colorOnSurface" />

            <Spinner
                android:id="@+id/material_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/period_filter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/period_f_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/period_filter"
                android:textColor="?attr/colorOnSurface" />

            <Spinner
                android:id="@+id/period_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>