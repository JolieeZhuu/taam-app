<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">




    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="62dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:title="Artifact Detail"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Large"
            app:titleTextColor="#111827">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/back"
                android:textSize="14sp" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <ImageView
            android:id="@+id/artifactImage"
            android:layout_width="match_parent"
            android:layout_height="249dp"
            android:contentDescription="@string/picture_of_the_artifact"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_launcher_background" />

        <LinearLayout
            android:id="@+id/artifactInformationAndControls"
            android:layout_width="match_parent"
            android:layout_height="239dp"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:padding="16dp">


            <ScrollView
                android:id="@+id/artifactInformationScrollView"
                android:layout_width="285dp"
                android:layout_height="202dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/artifactInformationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/artifact_information"
                        android:textColor="#0D47A1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/artifactName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/name_of_the_artifact"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/num_of_likes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/likes_23"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/save_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/saved_yes"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/artifact_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/category"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/artifact_creator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/creator"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/artifact_dynasty_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dynasty_period"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/artifact_culture_origin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/culture_origin"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/artifact_lot_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lot_number"
                        android:textColor="#374151"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/artifact_material"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/material"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/Dimensions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dimensions"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/condition_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/condition_report"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/current_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/current_location"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/acquisition_method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/acquisition_method"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/provenance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/provenance"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/accession_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/accession_number"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/Notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/notes"
                        android:textColor="#374151"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/artifact_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/description"
                        android:textColor="#374151"
                        android:textSize="14sp" />


                </LinearLayout>

            </ScrollView>

            <LinearLayout
                android:layout_width="102dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="5dp">

                <Button
                    android:id="@+id/like_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/like"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/save"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/edit_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:enabled="false"
                    android:text="@string/edit"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/delete_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:enabled="false"
                    android:text="@string/delete"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/commentsSectionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textCommentsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comment_section"
            android:textColor="#0D47A1"
            android:textSize="20sp"
            android:textStyle="bold" />



        <LinearLayout
            android:id="@+id/commentInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTextComment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@android:drawable/edit_text"
                android:hint="@string/write_a_comment"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonPostComment"
                android:layout_width="89dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/post"
                android:textSize="14sp" />

        </LinearLayout>
        <Button
            android:id="@+id/enter_comment_section"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/view_comments"
            />

    </LinearLayout>



</LinearLayout>