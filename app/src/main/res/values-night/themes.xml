<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AsianArtMuseum" parent="Theme.Material3.Dark.NoActionBar">
        <!-- primary -->
        <item name="colorPrimary">@color/crimson_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/dark_crimson</item>
        <item name="colorOnPrimaryContainer">@color/warm_beige</item>

        <!-- secondary -->
        <item name="colorSecondary">@color/golden_yellow</item>
        <item name="colorOnSecondary">@color/ink_black</item>
        <item name="colorSecondaryContainer">@color/dark_gold</item>
        <item name="colorOnSecondaryContainer">@color/warm_beige</item>

        <!-- tertiary -->
        <item name="colorTertiary">@color/sage_green</item>
        <item name="colorOnTertiary">@color/ink_black</item>
        <item name="colorOutline">@color/taupe_gray</item>

        <!-- background/text -->
        <item name="android:windowBackground">@color/ink_black</item>
        <item name="colorSurface">@color/charcoal_brown</item>
        <item name="colorOnSurface">@color/warm_beige</item>
        <item name="colorOnSurfaceVariant">@color/taupe_gray</item>

        <!-- system -->
        <item name="android:statusBarColor">@color/ink_black</item>
        <item name="android:navigationBarColor">@color/ink_black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- fonts -->
        <item name="fontFamily">@font/noto_sans_sc_regular</item>
    </style>

    <style name="Theme.AsianArtMuseum" parent="Base.Theme.AsianArtMuseum" />
</resources>